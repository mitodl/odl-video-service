AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_S3_DOMAIN=s3.amazonaws.com
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
AWS_ROLE_NAME=
CLOUDFRONT_KEY_ID=
CLOUDFRONT_PRIVATE_KEY=
DJANGO_LOG_LEVEL=DEBUG
DROPBOX_KEY=
DROPBOX_SECRET=
DROPBOX_REFRESH_TOKEN=
ENABLE_VIDEO_PERMISSIONS=False
VIDEO_S3_TRANSCODE_ENDPOINT=
# Name of the MediaConvert queue to use (default: Default)
VIDEO_TRANSCODE_QUEUE=Default
TRANSCODE_JOB_TEMPLATE=config/mediaconvert.json
# Fernet encryption key for EdxEndpoint.client_id and secret_key fields.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
GA_DIMENSION_CAMERA=
GA_KEYFILE_JSON=
GA_TRACKING_ID=UA-blablabla
GA_VIEW_ID=171841111
LECTURE_CAPTURE_USER=
MAILGUN_KEY=
MAILGUN_RECIPIENT_OVERRIDE=
MAILGUN_URL=
ODL_VIDEO_BASE_URL=http://ovs.odl.local:8089
ODL_VIDEO_LOG_LEVEL=DEBUG
REDIS_URL=
SECRET_KEY=
SENTRY_DSN=
VIDEO_CLOUDFRONT_DIST=
VIDEO_CDN_DISTRIBUTION_ID=
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin-allow-popups
VIDEO_S3_BUCKET=
VIDEO_S3_SUBTITLE_BUCKET=
VIDEO_S3_THUMBNAIL_BUCKET=
VIDEO_S3_TRANSCODE_BUCKET=
VIDEO_STATUS_UPDATE_FREQUENCY=60
VIDEO_WATCH_BUCKET_FREQUENCY=30
YT_ACCESS_TOKEN=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_UPLOAD_FREQUENCY=
YT_UPLOAD_LIMIT=
YT_PROJECT_ID=
YT_REFRESH_TOKEN=

# Keycloak configuration
USE_KEYCLOAK=True

# Runtime OIDC login — consumed by social-auth-app-django.
SOCIAL_AUTH_KEYCLOAK_KEY=odl-video-app
SOCIAL_AUTH_KEYCLOAK_SECRET=odl-video-secret-2025
SOCIAL_AUTH_KEYCLOAK_AUTHORIZATION_URL=http://kc.odl.local:7080/realms/ovs-local/protocol/openid-connect/auth
SOCIAL_AUTH_KEYCLOAK_ACCESS_TOKEN_URL=http://kc.odl.local:7080/realms/ovs-local/protocol/openid-connect/token

# Admin-API access — consumed by the moira-to-keycloak migration commands.
KEYCLOAK_SERVER_URL=http://kc.odl.local:7080
KEYCLOAK_REALM=ovs-local
KEYCLOAK_SVC_ADMIN=admin
KEYCLOAK_SVC_ADMIN_PASSWORD=admin

# Local Keycloak container bootstrap.
KEYCLOAK_SVC_KEYSTORE_PASSWORD=supersecret123456
KEYCLOAK_SVC_HOSTNAME=kc.odl.local
KEYCLOAK_PORT=7080
KEYCLOAK_SSL_PORT=7443

# Maximum thumbnail upload size in bytes (default 1 MB). Keep in sync with NGINX_CLIENT_MAX_BODY_SIZE.
THUMBNAIL_UPLOAD_MAX_SIZE=1048576
# nginx client_max_body_size for thumbnail uploads. Must be >= THUMBNAIL_UPLOAD_MAX_SIZE.
NGINX_CLIENT_MAX_BODY_SIZE=1m
